module Doreme where

import DA.Tuple
import DA.List
import Daml.Script

song : [(Text, Text)]
let song = [("do", "a deer, a female deer"), ("re", "a drop of golden sun"), ("mi", "a name, I call myself"), ("fa", "a long long way to run")]

splitNum : Int
let splitNum = song.size

testFunctions: Script()
testFunctions = script do
    show $ splitNum
