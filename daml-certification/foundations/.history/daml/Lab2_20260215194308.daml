module Lab2 where
import Daml.Script
import DA.Map
import DA.Tuple

song : [(Text, Text)]
song = [("do", "a deer, a female deer"), ("re", "a drop of golden sun"), ("mi", "a name, I call myself"), ("fa", "a long long way to run")]

mapSong = fromList song


testLab2 : Script ()
testLab2 = do
	f1 = fst song
	f2 = snd song
	debug $ f1
	debug $ f2
	debug $ mapSong
