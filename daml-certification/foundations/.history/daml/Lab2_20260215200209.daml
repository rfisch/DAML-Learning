module Lab2 where
import Daml.Script
import DA.List

song : [(Text, Text)]
song =
  [ ("do", "a deer, a female deer")
  , ("re", "a drop of golden sun")
  , ("mi", "a name, I call myself")
  , ("fa", "a long long way to run")
  ]


testLab2 : Script ()
testLab2 = script do
	let p1 = head song
	debug p1
	let p2 = head (tail song)
	debug p2
	let p3 = head (tail (tail song))
	debug p3
	let p4 = head (tail (tail (tail song)))
	debug p4
