module Lab2 where
import Daml.Script
import DA.Map
import DA.Tuple

song : [(Text, Text)]
song =
  [ ("do", "a deer, a female deer")
  , ("re", "a drop of golden sun")
  , ("mi", "a name, I call myself")
  , ("fa", "a long long way to run")
  ]


testLab2 : Script ()
testLab2 = script do
	debug $ song
	let m = fromList song
	debug $ m
	debug $ lookup "do" m
	debug $ lookup "re" m
	debug $ lookup "mi" m
	debug $ lookup "fa" m
