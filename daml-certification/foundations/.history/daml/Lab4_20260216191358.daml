module Lab4 where
import Daml.Script

getLetterGradeUsingIf: Decimal -> Text
getScoreUsingCase: Text -> Text
getLetterGradUsingGuards: Decimal -> Text
getAverageGradeLetter: Decimal -> Decimal -> Text

getLetterGradeUsingIf score =
  if score >= 90.0 then "A"
  else if score >= 80.0 then "B"
  else if score >= 70.0 then "C"
  else if score >= 60.0 then "D"
  else "F"

getScoreUsingCase letterGrade =
  case letterGrade of
    "A" -> "90.0 or above"
    "B" -> "from 80.0 to less than 90.0"
    "C" -> "from 70.0 to less than 80.0"
    "D" -> "from 60.0 to less than 70.0"
    "F" -> "Less than 60.0"
    _   -> "Unknown grade"

getLetterGradUsingGuards score
  | score >= 90.0 = "A"
  | score >= 80.0 = "B"
  | score >= 70.0 = "C"
  | otherwise = "F"

getAverageGradeLetter score1 score2 
  | average >= 90.0 = "A"
  | average >= 80.0 = "B"
  | average >= 70.0 = "C"
  | otherwise = "F"
  where average = (score1 + score2) / 2.0

testLab4 : Script ()
testLab4 = script do
  debug $ getLetterGradeUsingIf 90.0
  debug $ getLetterGradeUsingIf 85.0
  debug $ getLetterGradeUsingIf 75.0
  debug $ getLetterGradeUsingIf 65.00
  debug "----------"
  debug $ getScoreUsingCase "A"
  debug $ getScoreUsingCase "B"
  debug $ getScoreUsingCase "C"
  debug $ getScoreUsingCase "F"
  debug $ getScoreUsingCase "X"
  debug "----------"
  debug $ getLetterGradUsingGuards 90.0
  debug $ getLetterGradUsingGuards 80.0
  debug $ getLetterGradUsingGuards 70.0
  debug $ getLetterGradUsingGuards 60.0
  debug "----------"
  debug $ getAverageGradeLetter 75.0 83.0
  debug $ getAverageGradeLetter 95.0 83.0
  debug $ getAverageGradeLetter 98.0 83.0
  debug $ getAverageGradeLetter 60.0 70.0

  return()
