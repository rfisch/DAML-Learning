module Lab3 where
import Daml.Script


data Person = Person with
	name : Text
	email : Text
		deriving (Eq, Show, Ord)



testLab2 : Script ()
testLab2 = script do
	let 
		p1 = Person with 
			name = "Alice", 
			email = "alice@domain.com"
	let p2 = 
		Person with 
			name = "Bob", 
			email = "bob@domain.com"
	
	debug p1
	debug p2
	debug (p1 == p2)
	return ()
