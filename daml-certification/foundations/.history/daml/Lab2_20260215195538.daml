module Lab2 where
import Daml.Script
import DA.List

song : [(Text, Text)]
song =
  [ ("do", "a deer, a female deer")
  , ("re", "a drop of golden sun")
  , ("mi", "a name, I call myself")
  , ("fa", "a long long way to run")
  ]


testLab2 : Script ()
testLab2 = script do
  -- Extract 4 pairs without case / map
  let p1 = head song
  let r1 = tail song

  let p2 = head r1
  let r2 = tail r1

  let p3 = head r2
  let r3 = tail r2

  let p4 = head r3

  -- Notes
  let n1 = fst p1
  let n2 = fst p2
  let n3 = fst p3
  let n4 = fst p4

  -- Meanings
  let m1 = snd p1
  let m2 = snd p2
  let m3 = snd p3
  let m4 = snd p4

  -- Forward order lists
  let notesInOrder    = [n1, n2, n3, n4]
  let meaningsInOrder = [m1, m2, m3, m4]

  debug notesInOrder
  debug meaningsInOrder

  -- Reverse order lists (no reverse function)
  let notesReverse    = [n4, n3, n2, n1]
  let meaningsReverse = [m4, m3, m2, m1]

  debug notesReverse
  debug meaningsReverse
