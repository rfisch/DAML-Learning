module Lab5 where
import Daml.Script
import DA.Map qualified as Map
import DA.Map (Map)

song = [("do", "a deer, a female deer"), ("re", "a drop of golden sun"), ("mi", "a name, I call myself"), ("fa", "a long long way to run")]

-- Build a Map from a list of tuples
songMap : Map Text Text
songMap = Map.fromList song

testScript : Script ()
testScript = do
	let x = map fst song in
	let y = map snd song in

	debug $"Keys: " <>  show x
	debug $"Values: " <> show y
