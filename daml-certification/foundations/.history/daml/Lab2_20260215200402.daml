module Lab2 where
import Daml.Script
import DA.List

song : [(Text, Text)]
song =
  [ ("do", "a deer, a female deer")
  , ("re", "a drop of golden sun")
  , ("mi", "a name, I call myself")
  , ("fa", "a long long way to run")
  ]


testLab2 : Script ()
testLab2 = script do
	let l2 = [fst(head song),fst(head (tail song)), fst(head (tail (tail song))), fst(head (tail (tail (tail song))))] 
	debug l2
