module Mod2Lab1 where

template CLPAccount
  with
	  customer: Party
	  airline: Party
	  name: Text
	  address: Text
	  email: Text
	  accountTimestamp: Time
	  dob: Date
	  points: Int
	where
		signatory customer
		signatory airline

template CLPApplication
	with
		customer : Party
		airline: Party
		name: Text
		address: Text
		email: Text
		phone: Optional Text
		appTimestamp: Time
		dob: Date
	where
		signatory customer
		observer airline

		choice SubmitApplication: ContractId CLPApplication
			with
				customer: Party
				airline: Party
				name: Text
				address: Text
				email: Text
				phone: Optional Text
				appTimestamp: Time
				dob: Date
			controller customer
			do 
				create this 

		choice AcceptApplication: ContractId CLPAccount
			with
				customer : Party
				airline: Party
				name: Text
				address: Text
				email: Text
				accountTimestamp: Time
				dob: Date
			controller airline
			do 
				create CLPAccount with 
					customer = customer
					airline = airline
					name = name
					address = address
					email = email
					accountTimestamp = accountTimestamp
					dob = dob
					points = 0
			
		choice RejectApplication: ()
			with
			controller airline
			do 
				return (trace "Application rejected" ())
